meta {
  name: login user
  type: http
  seq: 2
}

post {
  url: {{baseurl}}/api/v1/users/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "james",
    "password": "password"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("auth_token", res.body.token);
  
    const jar = bru.cookies.jar();
  
    const csrf_token = await jar.getCookie("http://localhost:3000", "XSRF-TOKEN");
  
    bru.setEnvVar("csrf_token", csrf_token.value);
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
